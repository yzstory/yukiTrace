# ── 数据库 ──
DATABASE_URL="postgresql://yukitrace:yukitrace@localhost:5432/yukitrace?schema=public"

# ── 认证 ──
# 生成：openssl rand -base64 32
AUTH_SECRET="change-me"
# 是否允许公开注册（true/false）
ALLOW_SIGNUP="true"

# ── 高德地图 ──
# Web 端 (JS API) Key 与安全密钥，浏览器使用
NEXT_PUBLIC_AMAP_JS_KEY=""
NEXT_PUBLIC_AMAP_SECURITY_CODE=""
# Web 服务 Key，仅服务端使用（路径规划 / 天气 / POI）
AMAP_WEB_SERVICE_KEY=""

# ── 阿里云 OSS ──
OSS_REGION="oss-cn-hangzhou"
OSS_BUCKET=""
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
# 可选：STS 角色 ARN，用于前端直传临时凭证；为空则使用服务端签名上传
OSS_STS_ROLE_ARN=""
# 可选：自定义域名/CDN，例如 https://img.example.com
OSS_PUBLIC_BASE_URL=""

# ── AI（OpenAI 兼容）──
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
# 支持图片输入的模型（票据识别），可与 AI_MODEL 相同
AI_VISION_MODEL="gpt-4o-mini"

/* Trace 小程序设计系统：接近 iOS 的分层背景、圆角卡片与系统字号 */
page {
  --bg: #F2F2F7;
  --card: #FFFFFF;
  --fill: rgba(120, 120, 128, 0.12);
  --fill-2: rgba(120, 120, 128, 0.2);
  --separator: rgba(60, 60, 67, 0.12);
  --label: #1C1C1E;
  --label-2: #6E6E73;
  --label-3: #AEAEB2;
  --blue: #0A84FF;
  --green: #34C759;
  --orange: #FF9500;
  --red: #FF3B30;
  --purple: #AF52DE;
  --teal: #30B0C7;
  --pink: #FF2D55;
  --yellow: #FFCC00;
  --radius: 32rpx;
  background: var(--bg);
  color: var(--label);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  font-size: 32rpx;
  line-height: 1.4;
  -webkit-font-smoothing: antialiased;
}

/* 布局 */
.page { padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom)); }
.page-tab { padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); }
.stack { display: flex; flex-direction: column; gap: 24rpx; }
.row { display: flex; align-items: center; gap: 16rpx; }
.row-between { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.grow { flex: 1; min-width: 0; }
.wrap { display: flex; flex-wrap: wrap; gap: 16rpx; }
.center { text-align: center; }
.mt-8 { margin-top: 16rpx; }
.mt-16 { margin-top: 32rpx; }
.mt-24 { margin-top: 48rpx; }
.mb-8 { margin-bottom: 16rpx; }
.mb-16 { margin-bottom: 32rpx; }

/* 字号（iOS 文字样式） */
.large-title { font-size: 68rpx; font-weight: 700; letter-spacing: -0.5rpx; line-height: 1.15; }
.title-1 { font-size: 56rpx; font-weight: 700; line-height: 1.2; }
.title-2 { font-size: 44rpx; font-weight: 700; line-height: 1.25; }
.title-3 { font-size: 40rpx; font-weight: 600; line-height: 1.25; }
.headline { font-size: 34rpx; font-weight: 600; }
.body { font-size: 34rpx; }
.callout { font-size: 32rpx; }
.subhead { font-size: 30rpx; }
.footnote { font-size: 26rpx; }
.caption { font-size: 24rpx; }
.muted { color: var(--label-2); }
.faint { color: var(--label-3); }
.primary { color: var(--blue); }
.danger { color: var(--red); }
.bold { font-weight: 600; }
.mono { font-variant-numeric: tabular-nums; }
.ellipsis { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.display-number { font-size: 64rpx; font-weight: 700; letter-spacing: -1rpx; font-variant-numeric: tabular-nums; line-height: 1; }

/* 卡片与列表 */
.card { background: var(--card); border-radius: var(--radius); padding: 28rpx 32rpx; box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04); }
.card-tight { padding: 0; overflow: hidden; }
.cell { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 32rpx; min-height: 96rpx; background: var(--card); }
.cell + .cell { border-top: 1rpx solid var(--separator); }
.cell-arrow::after { content: "›"; color: var(--label-3); font-size: 40rpx; margin-left: auto; padding-left: 16rpx; }
.section-title { font-size: 26rpx; font-weight: 600; color: var(--label-2); text-transform: uppercase; letter-spacing: 1rpx; padding: 0 8rpx; margin: 40rpx 0 16rpx; }
.section-title:first-child { margin-top: 0; }
.divider { height: 1rpx; background: var(--separator); margin: 16rpx 0; }
.empty { padding: 64rpx 32rpx; text-align: center; color: var(--label-2); font-size: 30rpx; background: var(--card); border-radius: var(--radius); }
.empty-emoji { font-size: 72rpx; line-height: 1; margin-bottom: 16rpx; }

/* 按钮 */
.btn { display: flex; align-items: center; justify-content: center; gap: 12rpx; height: 96rpx; padding: 0 40rpx; border-radius: 28rpx; font-size: 34rpx; font-weight: 600; background: var(--fill); color: var(--label); line-height: 1; margin: 0; border: none; }
.btn::after { border: none; }
.btn-primary { background: var(--blue); color: #fff; }
.btn-danger { background: rgba(255, 59, 48, 0.12); color: var(--red); }
.btn-ghost { background: transparent; color: var(--blue); }
.btn-sm { height: 68rpx; padding: 0 28rpx; font-size: 28rpx; border-radius: 20rpx; }
.btn-block { width: 100%; }
.btn[disabled], .btn.disabled { opacity: 0.5; }
.btn-hover { opacity: 0.8; transform: scale(0.97); }
.pill { display: inline-flex; align-items: center; gap: 8rpx; height: 56rpx; padding: 0 22rpx; border-radius: 999rpx; background: var(--card); font-size: 26rpx; font-weight: 500; color: var(--label); box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04); }
.pill-fill { background: var(--fill); box-shadow: none; }
.pill-on { background: var(--label); color: #fff; }
.pill-blue { background: rgba(10, 132, 255, 0.12); color: var(--blue); }
.chip { display: inline-flex; align-items: center; gap: 6rpx; height: 44rpx; padding: 0 16rpx; border-radius: 12rpx; background: var(--fill); font-size: 24rpx; color: var(--label-2); }

/* 表单 */
.field { display: flex; flex-direction: column; gap: 10rpx; padding: 20rpx 32rpx; background: var(--card); }
.field + .field { border-top: 1rpx solid var(--separator); }
.field-label { font-size: 26rpx; color: var(--label-2); }
.field-input { font-size: 34rpx; height: 64rpx; line-height: 64rpx; }
.field-textarea { font-size: 32rpx; width: 100%; min-height: 160rpx; line-height: 1.5; }
.field-value { font-size: 34rpx; min-height: 64rpx; line-height: 64rpx; }
.field-inline { flex-direction: row; align-items: center; justify-content: space-between; }
.field-inline .field-label { font-size: 32rpx; color: var(--label); }
.placeholder { color: var(--label-3); }
.form-group { background: var(--card); border-radius: var(--radius); overflow: hidden; box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04); }
.error-text { color: var(--red); font-size: 26rpx; padding: 8rpx 8rpx 0; }

/* 浮动按钮 */
.fab { position: fixed; right: 40rpx; bottom: calc(60rpx + env(safe-area-inset-bottom)); width: 112rpx; height: 112rpx; border-radius: 50%; background: var(--blue); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 60rpx; font-weight: 300; box-shadow: 0 12rpx 32rpx rgba(10, 132, 255, 0.35); z-index: 20; }
.fab-tab { bottom: calc(60rpx + env(safe-area-inset-bottom)); }
.fab-ai { right: 40rpx; bottom: calc(196rpx + env(safe-area-inset-bottom)); width: 96rpx; height: 96rpx; background: var(--card); color: var(--purple); font-size: 44rpx; box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12); }

/* 底部弹层 */
.sheet-mask { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.35); z-index: 50; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; background: var(--bg); border-radius: 40rpx 40rpx 0 0; padding: 16rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); z-index: 51; max-height: 85vh; overflow-y: auto; }
.sheet-handle { width: 72rpx; height: 8rpx; border-radius: 4rpx; background: var(--fill-2); margin: 0 auto 24rpx; }
.sheet-title { font-size: 34rpx; font-weight: 600; text-align: center; margin-bottom: 24rpx; }
.grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; }
.grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; }
.tile { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; height: 140rpx; background: var(--card); border-radius: 24rpx; font-size: 26rpx; }
.tile-emoji { font-size: 44rpx; line-height: 1; }
.tile-on { background: var(--label); color: #fff; }

/* 图片 */
.avatar { width: 96rpx; height: 96rpx; border-radius: 50%; background: var(--fill); display: flex; align-items: center; justify-content: center; font-size: 40rpx; font-weight: 600; }
.thumb { width: 160rpx; height: 160rpx; border-radius: 20rpx; background: var(--fill); flex-shrink: 0; }
.loading { padding: 96rpx 0; text-align: center; color: var(--label-3); font-size: 28rpx; }

/* 深色模式：只换变量，组件样式不变 */
@media (prefers-color-scheme: dark) {
  page {
    --bg: #000000;
    --card: #1C1C1E;
    --fill: rgba(120, 120, 128, 0.24);
    --fill-2: rgba(120, 120, 128, 0.36);
    --separator: rgba(84, 84, 88, 0.6);
    --label: #F2F2F7;
    --label-2: #98989F;
    --label-3: #636366;
  }
  .card, .cell, .field, .form-group, .empty, .pill, .tile, .hint { box-shadow: none; }
  .pill-on, .tile-on { background: #F2F2F7; color: #1C1C1E; }
  .sheet { background: #1C1C1E; }
  .tile, .kpi { background: #2C2C2E; }
  .fab-ai { background: #2C2C2E; }
}

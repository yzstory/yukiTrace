.bar { height: 12rpx; background: var(--fill); border-radius: 6rpx; overflow: hidden; }
.bar-fill { height: 100%; background: var(--green); border-radius: 6rpx; }
.box { width: 44rpx; height: 44rpx; border-radius: 50%; border: 3rpx solid var(--label-3); display: flex; align-items: center; justify-content: center; font-size: 26rpx; color: #fff; flex-shrink: 0; }
.box-on { background: var(--green); border-color: var(--green); }
.strike { text-decoration: line-through; }

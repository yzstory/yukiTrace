.header { margin: 8rpx 8rpx 32rpx; }
.trip-card { position: relative; height: 400rpx; border-radius: var(--radius); overflow: hidden; background: var(--card); box-shadow: 0 8rpx 28rpx rgba(0,0,0,0.08); }
.trip-hover { opacity: 0.92; transform: scale(0.985); }
.trip-cover { position: absolute; inset: 0; width: 100%; height: 100%; }
.trip-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0) 30%, rgba(0,0,0,0.65) 100%); }
.trip-body { position: absolute; left: 32rpx; right: 32rpx; bottom: 28rpx; color: #fff; display: flex; flex-direction: column; gap: 6rpx; }
.trip-title { font-size: 44rpx; font-weight: 700; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3); }
.trip-meta { font-size: 26rpx; opacity: 0.9; }
.trip-stats { display: flex; gap: 24rpx; font-size: 24rpx; opacity: 0.85; margin-top: 4rpx; font-variant-numeric: tabular-nums; }
.chip-glass { background: rgba(255,255,255,0.25); color: #fff; backdrop-filter: blur(10px); }

<view class="page page-tab">
  <view class="large-title" style="margin: 8rpx 8rpx 24rpx">我</view>

  <view class="passport" hover-class="btn-hover" bindtap="openPassport" wx:if="{{passport}}">
    <view class="row-between">
      <view>
        <view class="caption" style="opacity: .8">{{passport.babyName ? passport.babyName + '的' : ''}}旅行护照</view>
        <view class="title-2 mt-8">{{passport.cities}} 座城市</view>
        <view class="footnote mt-8" style="opacity: .9">{{passport.pending ? passport.pending + ' 枚章等着盖' : '所有章都盖好了'}}<text wx:if="{{passport.flights}}"> · {{passport.flights}} 次飞行</text></view>
      </view>
      <view class="stamp">🛂</view>
    </view>
  </view>

  <view class="card mt-16" wx:if="{{user}}">
    <view class="row">
      <view class="avatar">{{initial}}</view>
      <view class="grow"><view class="headline">{{user.name}}</view><view class="subhead muted">{{user.email}}</view></view>
    </view>
  </view>

  <block wx:if="{{years.length}}">
    <view class="section-title">✨ 年度回顾</view>
    <scroll-view scroll-x class="years"><view class="pill" wx:for="{{years}}" wx:key="*this" hover-class="btn-hover" data-year="{{item}}" bindtap="openYear">{{item}} 年 ›</view></scroll-view>
  </block>

  <view class="section-title">👶 同一个地方，不同的年纪</view>
  <view class="empty" wx:if="{{!growth.length}}">再去一次去过的城市，这里就会把两次的照片放在一起。</view>
  <view class="card mb-16" wx:for="{{growth}}" wx:key="city" wx:for-item="g">
    <view class="headline mb-8">{{g.city}}</view>
    <scroll-view scroll-x class="visits">
      <view class="visit" wx:for="{{g.visits}}" wx:key="tripId" wx:for-item="v" data-id="{{v.tripId}}" bindtap="openTripPhotos">
        <image wx:if="{{v.photo}}" class="visit-img" src="{{v.photo}}" mode="aspectFill" lazy-load />
        <view wx:else class="visit-img visit-empty">📷</view>
        <view class="footnote bold ellipsis">{{v.month}}</view>
        <view class="caption muted ellipsis">{{v.ageText || v.title}}</view>
      </view>
    </scroll-view>
  </view>

  <view class="section-title">助手</view>
  <view class="form-group">
    <view class="cell cell-arrow" hover-class="btn-hover" bindtap="openAi"><text>✦ 跨旅程回忆问答</text><text class="caption muted">住过哪、花了多少、那年今日</text></view>
  </view>

  <view class="section-title">设置</view>
  <view class="form-group">
    <view class="cell cell-arrow" hover-class="btn-hover" bindtap="toggleWechat"><text>微信一键登录</text><text class="caption muted grow" style="text-align:right">{{!wechat ? '…' : !wechat.configured ? '服务器未配置' : wechat.bound ? '已绑定' : '未绑定'}}</text></view>
    <view class="cell cell-arrow" hover-class="btn-hover" bindtap="changeServer"><text>服务器地址</text><text class="caption muted ellipsis grow" style="text-align:right">{{server}}</text></view>
    <view class="cell cell-arrow" hover-class="btn-hover" bindtap="openTokens"><text>访问令牌</text><text class="caption muted">API / MCP</text></view>
  </view>

  <button class="btn btn-danger btn-block mt-24" hover-class="btn-hover" bindtap="logout">退出登录</button>
  <view class="caption faint center mt-16">Trace 小程序 {{version}}</view>
</view>

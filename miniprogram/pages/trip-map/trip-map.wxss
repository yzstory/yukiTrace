.wrap-page { position: relative; width: 100vw; height: 100vh; }
.map { width: 100%; height: 100%; }
.filters { position: absolute; top: 20rpx; left: 0; right: 0; white-space: nowrap; padding: 0 24rpx; box-sizing: border-box; }
.filters .pill { margin-right: 12rpx; }
.empty-tip { position: absolute; top: 40%; left: 60rpx; right: 60rpx; text-align: center; background: rgba(255,255,255,0.9); border-radius: 24rpx; padding: 24rpx; font-size: 28rpx; color: var(--label-2); }
.bottom { position: absolute; left: 0; right: 0; bottom: 0; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.detail { margin: 0 24rpx 16rpx; }
.cards { white-space: nowrap; padding: 0 24rpx; box-sizing: border-box; }
.stop-card { display: inline-flex; flex-direction: column; gap: 6rpx; width: 360rpx; padding: 20rpx 24rpx; margin-right: 16rpx; background: var(--card); border-radius: 24rpx; box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.12); vertical-align: top; white-space: normal; box-sizing: border-box; }
.stop-on { outline: 4rpx solid var(--blue); }
.num { width: 40rpx; height: 40rpx; border-radius: 50%; color: #fff; font-size: 22rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }

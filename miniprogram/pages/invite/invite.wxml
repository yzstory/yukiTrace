<view class="page">
  <view class="loading" wx:if="{{loading}}">正在读取邀请…</view>

  <block wx:elif="{{info}}">
    <view class="card invite">
      <view class="emoji">👨‍👩‍👧</view>
      <view class="title-2 center">{{info.trip.title}}</view>
      <view class="subhead muted center mt-8">{{info.range}}<text wx:if="{{info.trip.babyName}}"> · 和{{info.trip.babyName}}一起</text></view>
      <view class="footnote muted center mt-16">{{info.invitedBy}} 邀请你一起记录这段旅程</view>
      <view class="caption faint center mt-8">加入后可以记地点、花费、照片和宝宝状态 · 邀请{{info.expires === '不过期' ? '不过期' : '有效期至 ' + info.expires}}</view>
    </view>
    <button class="btn btn-primary btn-block mt-24" hover-class="btn-hover" loading="{{busy}}" bindtap="accept">{{needLogin ? '登录后加入' : '加入这段旅程'}}</button>
  </block>

  <block wx:else>
    <view class="empty">
      <view class="empty-emoji">✉️</view>
      <view>{{error || '没有找到邀请'}}</view>
      <view class="caption faint mt-8">复制家人发来的邀请链接后，点下面的按钮</view>
    </view>
    <button class="btn btn-block mt-16" hover-class="btn-hover" bindtap="paste">从剪贴板读取邀请链接</button>
  </block>
</view>

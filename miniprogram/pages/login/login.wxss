.login { padding: 0 48rpx 80rpx; min-height: 100vh; box-sizing: border-box; }
.brand { text-align: center; display: flex; flex-direction: column; gap: 8rpx; align-items: center; }
.brand-mark { width: 144rpx; height: 144rpx; border-radius: 40rpx; background: var(--card); box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.06); display: flex; align-items: center; justify-content: center; font-size: 72rpx; margin-bottom: 16rpx; }
.server { text-align: center; margin-top: 64rpx; }
.brand-logo { width: 440rpx; height: 190rpx; margin-bottom: 16rpx; }
@media (prefers-color-scheme: dark) { .brand-logo { filter: brightness(0) invert(1); } }

<view class="page">
  <scroll-view scroll-x class="types"><view class="pill pill-fill {{type === item.key ? 'pill-on' : ''}}" wx:for="{{types}}" wx:key="key" data-key="{{item.key}}" bindtap="setType">{{item.emoji}} {{item.label}}</view></scroll-view>

  <view class="section-title">{{cfg.label}}</view>
  <view class="form-group">
    <view class="field"><text class="field-label">标题</text><input class="field-input" placeholder="{{type === 'MEAL' ? '汤咖喱午餐' : type === 'MOMENT' ? '此刻发生了什么' : '一句话概括'}}" placeholder-class="placeholder" value="{{form.title}}" data-key="title" bindinput="onInput" maxlength="120" focus /></view>
    <view class="field" wx:for="{{cfg.fields}}" wx:key="key"><text class="field-label">{{item.label}}</text><input class="field-input" type="{{item.type === 'number' ? 'digit' : 'text'}}" placeholder="{{item.placeholder || ''}}" placeholder-class="placeholder" value="{{form.meta[item.key] || ''}}" data-key="{{item.key}}" bindinput="onMeta" /></view>
    <picker range="{{stops}}" range-key="name" value="{{stopIndex}}" bindchange="onStop"><view class="field field-inline"><text class="field-label">关联地点</text><text class="field-value ellipsis" style="max-width: 60%">{{stops[stopIndex].name}}</text></view></picker>
    <view class="field field-inline">
      <text class="field-label">开始</text>
      <view class="row">
        <picker mode="date" value="{{form.startDate}}" data-key="startDate" bindchange="onPick"><text class="field-value">{{form.startDate}}</text></picker>
        <picker mode="time" value="{{form.startTime}}" data-key="startTime" bindchange="onPick"><text class="field-value">{{form.startTime}}</text></picker>
      </view>
    </view>
    <view class="field field-inline">
      <text class="field-label">结束</text>
      <view class="row">
        <picker mode="date" value="{{form.endDate || form.startDate}}" start="{{form.startDate}}" data-key="endDate" bindchange="onPick"><text class="field-value {{form.endDate ? '' : 'placeholder'}}">{{form.endDate || '可选'}}</text></picker>
        <picker wx:if="{{form.endDate}}" mode="time" value="{{form.endTime || '18:00'}}" data-key="endTime" bindchange="onPick"><text class="field-value">{{form.endTime || '选时间'}}</text></picker>
        <text wx:if="{{form.endDate}}" class="caption primary" bindtap="clearEnd">清除</text>
      </view>
    </view>
    <view class="field"><text class="field-label">备注</text><textarea class="field-textarea" placeholder="想记住的细节" placeholder-class="placeholder" value="{{form.note}}" data-key="note" bindinput="onInput" auto-height /></view>
  </view>

  <view class="section-title">顺手记一笔（可选）</view>
  <view class="form-group">
    <view class="field field-inline">
      <text class="field-label">金额</text>
      <view class="row">
        <input class="field-input amount" type="digit" placeholder="0" placeholder-class="placeholder" value="{{form.amount}}" data-key="amount" bindinput="onInput" />
        <picker range="{{curLabels}}" value="{{curIndex}}" bindchange="onCurrency"><view class="pill pill-fill">{{form.currency}} ▾</view></picker>
      </view>
    </view>
    <view class="field" wx:if="{{form.amount}}">
      <text class="field-label">分类</text>
      <view class="wrap"><view class="pill pill-fill {{form.category === item.key ? 'pill-on' : ''}}" wx:for="{{cats}}" wx:key="key" data-key="{{item.key}}" bindtap="setCat">{{item.emoji}} {{item.label}}</view></view>
    </view>
    <view class="field field-inline" wx:if="{{form.amount}}"><text class="field-label">宝宝相关</text><switch checked="{{form.isBaby}}" bindchange="toggleBaby" color="#0A84FF" /></view>
  </view>

  <button class="btn btn-primary btn-block mt-24" hover-class="btn-hover" loading="{{busy}}" bindtap="submit">保存</button>
</view>

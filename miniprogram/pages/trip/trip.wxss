.hero { position: relative; height: 360rpx; border-radius: var(--radius); overflow: hidden; box-shadow: 0 8rpx 28rpx rgba(0,0,0,0.08); }
.hero-img { position: absolute; inset: 0; width: 100%; height: 100%; }
.hero-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0.05) 20%, rgba(0,0,0,0.65) 100%); }
.hero-body { position: absolute; left: 32rpx; right: 32rpx; bottom: 28rpx; color: #fff; display: flex; flex-direction: column; gap: 6rpx; text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3); }
.hero-stats { display: flex; gap: 24rpx; font-size: 24rpx; opacity: 0.9; font-variant-numeric: tabular-nums; }
.subnav { white-space: nowrap; margin: 24rpx 0 8rpx; }
.subnav .pill { margin-right: 12rpx; }
.uploading { padding: 8rpx 8rpx 0; }
.day { margin-top: 40rpx; }
.day-head { display: flex; align-items: baseline; gap: 12rpx; padding: 0 8rpx; margin-bottom: 16rpx; }
.day-num { font-size: 24rpx; font-weight: 700; color: var(--blue); background: rgba(10,132,255,0.12); border-radius: 10rpx; padding: 4rpx 12rpx; }
.note { margin-bottom: 16rpx; }
.leg { text-align: center; padding: 12rpx 0; }
.stop { margin-bottom: 12rpx; }
.stop-icon { width: 72rpx; height: 72rpx; border-radius: 20rpx; background: var(--fill); display: flex; align-items: center; justify-content: center; font-size: 36rpx; flex-shrink: 0; }
.indent { margin-left: 24rpx; padding-left: 24rpx; border-left: 4rpx solid var(--separator); margin-bottom: 16rpx; }
.entry { display: flex; align-items: flex-start; gap: 16rpx; padding: 16rpx 0; }
.entry + .entry { border-top: 1rpx solid var(--separator); }
.card-like { background: var(--card); border-radius: var(--radius); padding: 20rpx 28rpx; margin-bottom: 12rpx; box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04); }
.card-like + .card-like { border-top: none; }
.entry-emoji { width: 64rpx; height: 64rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; font-size: 32rpx; flex-shrink: 0; }
.photo-strip { white-space: nowrap; margin-top: 12rpx; }
.photo-strip .thumb { display: inline-block; margin-right: 12rpx; }
.baby-strip { white-space: nowrap; margin-top: 8rpx; }
.baby-strip .pill { margin-right: 12rpx; }
.day-empty { padding: 8rpx 8rpx 0; }
.pending { display: flex; align-items: center; gap: 16rpx; margin-top: 16rpx; }

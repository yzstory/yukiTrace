.group { margin-top: 24rpx; }
.group-head { padding: 0 8rpx 12rpx; }
.grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8rpx; }
.cellp { position: relative; aspect-ratio: 1; border-radius: 16rpx; overflow: hidden; background: var(--fill); }
.img { width: 100%; height: 100%; }
.cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 6rpx 10rpx; background: linear-gradient(0deg, rgba(0,0,0,0.55), transparent); color: #fff; }
.fab { font-size: 44rpx; }
